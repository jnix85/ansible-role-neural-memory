#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Managed by Ansible - do not edit directly
set -euo pipefail

BACKUP_DIR="{{ neural_memory_backup_dir }}"
CONTAINER_ENGINE="{{ neural_memory_container_engine }}"
USER_NAME="{{ neural_memory_user }}"
DB_NAME="{{ neural_memory_postgres_database }}"
TIMESTAMP=$(date +"%Y%m%d_%H%M%S")

echo "[$(date -Iseconds)] Triggering on-demand Neural Memory backup via sidecar container..."

if [ "${CONTAINER_ENGINE}" = "podman" ]; then
    # Trigger backup script inside the Podman rootless backup container
    su - "${USER_NAME}" -c "podman exec neural-memory-backup /backup.sh"
else
    # Trigger backup script inside the Docker Compose backup container
    docker compose -f "{{ neural_memory_install_dir }}/docker-compose.yml" exec -T backup /backup.sh
fi

LATEST_BACKUP=$(find "${BACKUP_DIR}" -maxdepth 1 -type f -name "*${DB_NAME}*.sql.gz" -printf '%T@ %p\n' 2>/dev/null | sort -n | tail -1 | cut -f2- -d" ")

if [ -n "${LATEST_BACKUP}" ] && [ -f "${LATEST_BACKUP}" ]; then
    BACKUP_SIZE=$(du -h "${LATEST_BACKUP}" | cut -f1)
    echo "[$(date -Iseconds)] Backup successful: ${LATEST_BACKUP} (${BACKUP_SIZE})"
else
    echo "[$(date -Iseconds)] Backup executed. Current archives in ${BACKUP_DIR}:"
    ls -lh "${BACKUP_DIR}"
fi
