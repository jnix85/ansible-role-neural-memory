# Nginx configuration for Neural Memory Ingress
# Managed by Ansible - do not edit directly

worker_processes auto;
pid /tmp/nginx.pid;
error_log /var/log/nginx/error.log warn;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    access_log /var/log/nginx/access.log main;
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    client_max_body_size 50M;

    server {
        listen {{ neural_memory_ingress_http_port }};
        server_name _;

        # Redirect HTTP to HTTPS
        location / {
            return 301 https://$host:{{ neural_memory_ingress_https_port }}$request_uri;
        }
    }

    server {
        listen {{ neural_memory_ingress_https_port }} ssl;
        http2 on;
        server_name _;

        ssl_certificate /etc/nginx/ssl/server.crt;
        ssl_certificate_key /etc/nginx/ssl/server.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers HIGH:!aNULL:!MD5;
        ssl_prefer_server_ciphers on;
        ssl_session_cache shared:SSL:10m;
        ssl_session_timeout 10m;

        # Streamable HTTP MCP JSON-RPC endpoint
        location /mcp {
            proxy_pass http://{{ 'neural-memory-mcp' if (neural_memory_container_engine == 'podman') else 'neural-memory-mcp' }}:{{ neural_memory_mcp_port }}/mcp;
            proxy_http_version 1.1;

            # Critical for MCP streaming and Server-Sent Events (SSE)
            proxy_buffering off;
            proxy_cache off;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;

            proxy_set_header Connection '';
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # FastAPI REST API and Web Dashboard
        location / {
            proxy_pass http://{{ 'neural-memory-web' if (neural_memory_container_engine == 'podman') else 'neural-memory' }}:8000;
            proxy_http_version 1.1;

            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}
