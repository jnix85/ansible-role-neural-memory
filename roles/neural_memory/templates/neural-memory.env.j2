# NeuralMemory Environment Configuration
# Managed by Ansible - do not edit directly

# --- Core Server Settings ---
NEURAL_MEMORY_HOST={{ neural_memory_bind_host }}
NEURAL_MEMORY_PORT={{ neural_memory_web_port }}
NEURAL_MEMORY_DEBUG={{ neural_memory_debug | lower }}
NEURAL_MEMORY_STORAGE={{ neural_memory_storage_backend }}
NEURALMEMORY_DIR=/data
NMEM_BRAIN={{ neural_memory_default_brain }}
NEURAL_MEMORY_API_KEY={{ neural_memory_effective_api_key }}
NEURAL_MEMORY_RATE_LIMIT={{ neural_memory_rate_limit }}
NEURAL_MEMORY_RATE_LIMIT_WINDOW={{ neural_memory_rate_limit_window }}
NEURAL_MEMORY_TRUSTED_NETWORKS={{ neural_memory_trusted_networks | join(',') }}

# --- PostgreSQL & pgvector Settings ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD={{ neural_memory_effective_postgres_password }}
POSTGRES_DB=postgres
NEURAL_MEMORY_POSTGRES_HOST={{ neural_memory_postgres_host }}
NEURAL_MEMORY_POSTGRES_PORT={{ neural_memory_postgres_port }}
NEURAL_MEMORY_POSTGRES_DATABASE={{ neural_memory_postgres_database }}
NEURAL_MEMORY_POSTGRES_USER={{ neural_memory_postgres_user }}
NEURAL_MEMORY_POSTGRES_PASSWORD={{ neural_memory_effective_postgres_password }}
NEURAL_MEMORY_STORAGE_EMBEDDING_DIM={{ neural_memory_embedding_dim }}

# --- LLM Gateway / Providers (Bifrost compatible) ---
{% if neural_memory_openai_base_url %}
OPENAI_BASE_URL={{ neural_memory_openai_base_url }}
{% endif %}
{% if neural_memory_openai_api_key %}
OPENAI_API_KEY={{ neural_memory_openai_api_key }}
{% endif %}
{% if neural_memory_llm_gateway_url %}
NEURAL_MEMORY_LLM_GATEWAY_URL={{ neural_memory_llm_gateway_url }}
NEURAL_MEMORY_LLM_GATEWAY_MODEL={{ neural_memory_llm_gateway_model }}
{% endif %}
{% if neural_memory_gemini_api_key %}
GEMINI_API_KEY={{ neural_memory_gemini_api_key }}
{% endif %}
{% if neural_memory_anthropic_api_key %}
ANTHROPIC_API_KEY={{ neural_memory_anthropic_api_key }}
{% endif %}

# --- Scheduled Consolidation & Background Daemons ---
NEURAL_MEMORY_SCHEDULED_CONSOLIDATION_INTERVAL_HOURS={{ neural_memory_consolidation_interval_hours }}
NEURAL_MEMORY_DECAY_INTERVAL_HOURS={{ neural_memory_decay_interval_hours }}
